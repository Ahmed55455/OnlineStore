@model List<OnlineStore.Models.Product>

@{
    ViewData["Title"] = "Products";
    var categories = ViewBag.Categories as List<OnlineStore.Models.Category>;
    var selected   = ViewBag.SelectedCategory as string;
    var search     = ViewBag.SearchQuery as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-grid"></i> Products
    </h2>
    <span class="text-muted">@Model.Count item(s) found</span>
</div>

<!-- Search Bar -->
<form asp-controller="Products" asp-action="Index" method="get" class="mb-4">
    <input type="hidden" name="category" value="@selected" />
    <div class="input-group shadow-sm" style="max-width:500px">
        <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text"
               name="search"
               value="@search"
               class="form-control border-start-0 ps-0"
               placeholder="Search products..." />
        <button type="submit"
                class="btn text-white"
                style="background:#1a1a2e">
            Search
        </button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-controller="Products" asp-action="Index"
               asp-route-category="@selected"
               class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </div>
</form>

<!-- Category Filter -->
<div class="mb-4 d-flex flex-wrap gap-2">
    <a asp-controller="Products" asp-action="Index"
       asp-route-search="@search"
       class="btn btn-sm @(selected == null ? "btn-dark" : "btn-outline-dark")">
        All
    </a>
    @foreach (var cat in categories!)
    {
        <a asp-controller="Products" asp-action="Index"
           asp-route-category="@cat.Name"
           asp-route-search="@search"
           class="btn btn-sm @(selected == cat.Name ? "btn-dark" : "btn-outline-dark")">
            @cat.Name
        </a>
    }
</div>

<!-- Search Result Message -->
@if (!string.IsNullOrEmpty(search))
{
    <div class="alert alert-info mb-4">
        <i class="bi bi-search"></i>
        Showing results for <strong>"@search"</strong>
        — @Model.Count product(s) found
    </div>
}

<!-- Products Grid -->
@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-box-seam" style="font-size:80px; color:#ccc"></i>
        <h4 class="mt-3 text-muted">No products found</h4>
        <a asp-controller="Products" asp-action="Index"
           class="btn btn-primary mt-3 px-5">
            <i class="bi bi-arrow-left"></i> Back to All Products
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 rounded-4">
                    <img src="@product.ImageUrl"
                         class="card-img-top rounded-top-4"
                         alt="@product.Name"
                         style="height:200px; object-fit:cover;" />
                    <div class="card-body">
                        <span class="badge mb-2" style="background:#1a1a2e">
                            @product.Category?.Name
                        </span>
                        <h5 class="card-title fw-bold">@product.Name</h5>
                        <p class="card-text text-muted" style="font-size:14px">
                            @product.Description
                        </p>
                    </div>
                    <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold fs-5" style="color:#1a1a2e">
                                $@product.Price.ToString("0.00")
                            </span>
                            @if (product.Stock > 0)
                            {
                                <span class="badge bg-success ms-2">
                                    In Stock (@product.Stock)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger ms-2">Out of Stock</span>
                            }
                        </div>
                        <a asp-controller="Products"
                           asp-action="Detail"
                           asp-route-id="@product.Id"
                           class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-eye"></i> View
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}