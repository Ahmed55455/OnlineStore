@model OnlineStore.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <a asp-controller="Products" asp-action="Index"
           class="btn btn-outline-dark btn-sm mb-4">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="row g-0">
                <!-- Product Image -->
                <div class="col-md-5">
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="img-fluid h-100"
                         style="object-fit:cover; min-height:350px;" />
                </div>

                <!-- Product Info -->
                <div class="col-md-7">
                    <div class="card-body p-5">
                        <span class="badge mb-3" style="background:#1a1a2e; font-size:13px">
                            @Model.Category?.Name
                        </span>
                        <h2 class="fw-bold mb-3">@Model.Name</h2>
                        <p class="text-muted mb-4">@Model.Description</p>

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <span class="fs-2 fw-bold" style="color:#1a1a2e">
                                $@Model.Price.ToString("0.00")
                            </span>
                            @if (Model.Stock > 0)
                            {
                                <span class="badge bg-success fs-6">
                                    <i class="bi bi-check-circle"></i> In Stock (@Model.Stock)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">Out of Stock</span>
                            }
                        </div>

                        @if (Model.Stock > 0)
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <label class="fw-bold">Quantity:</label>
                                    <input type="number" name="quantity"
                                           value="1" min="1" max="@Model.Stock"
                                           class="form-control"
                                           style="width:80px" />
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg px-5">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
