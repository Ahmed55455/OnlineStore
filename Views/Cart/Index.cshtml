@model List<OnlineStore.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<h2 class="fw-bold mb-4">
    <i class="bi bi-cart3"></i> Shopping Cart
</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-cart-x" style="font-size:80px; color:#ccc"></i>
        <h4 class="mt-3 text-muted">Your cart is empty</h4>
        <a asp-controller="Products" asp-action="Index"
           class="btn btn-primary mt-3 px-5">
            <i class="bi bi-grid"></i> Browse Products
        </a>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead style="background:#1a1a2e; color:white;">
                            <tr>
                                <th class="p-3 rounded-top-4">Product</th>
                                <th class="p-3">Price</th>
                                <th class="p-3">Qty</th>
                                <th class="p-3">Total</th>
                                <th class="p-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="p-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@item.ImageUrl"
                                                 style="width:60px;height:50px;object-fit:cover;border-radius:8px" />
                                            <span class="fw-bold">@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td class="p-3 align-middle">$@item.UnitPrice.ToString("0.00")</td>
                                    <td class="p-3 align-middle">@item.Quantity</td>
                                    <td class="p-3 align-middle fw-bold">$@item.Total.ToString("0.00")</td>
                                    <td class="p-3 align-middle">
                                        <form asp-controller="Cart" asp-action="Remove" method="post">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Order Summary</h5>
                    <hr/>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Items (@Model.Count)</span>
                        <span>$@Model.Sum(c => c.Total).ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Shipping</span>
                        <span class="text-success">Free</span>
                    </div>
                    <hr/>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5">Total</span>
                        <span class="fw-bold fs-5" style="color:#1a1a2e">
                            $@Model.Sum(c => c.Total).ToString("0.00")
                        </span>
                    </div>
                    <a asp-controller="Cart" asp-action="Checkout"
                       class="btn btn-primary w-100 btn-lg">
                        <i class="bi bi-bag-check"></i> Proceed to Checkout
                    </a>
                    <a asp-controller="Products" asp-action="Index"
                       class="btn btn-outline-dark w-100 mt-2">
                        <i class="bi bi-arrow-left"></i> Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
}