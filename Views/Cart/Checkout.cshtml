@model List<OnlineStore.Models.CartItem>

@{
    ViewData["Title"] = "Checkout";
}

<h2 class="fw-bold mb-4">
    <i class="bi bi-bag-check"></i> Checkout
</h2>

<div class="row g-4">

    <!-- Customer Info Form -->
    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4">
                    <i class="bi bi-person"></i> Customer Information
                </h5>

                <form asp-controller="Cart" asp-action="PlaceOrder" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <input type="text" name="customerName"
                               class="form-control form-control-lg"
                               value="@ViewBag.UserName"
                               placeholder="John Doe" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input type="email" name="customerEmail"
                               class="form-control form-control-lg"
                               value="@ViewBag.UserEmail"
                               placeholder="john@example.com" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            <i class="bi bi-geo-alt"></i> Delivery Address
                        </label>
                        <textarea name="address"
                                  class="form-control form-control-lg"
                                  rows="3"
                                  placeholder="Enter your full delivery address..."
                                  required></textarea>
                    </div>

                    <button type="submit"
                            class="btn btn-lg w-100 text-white"
                            style="background:#1a1a2e">
                        <i class="bi bi-check-circle"></i> Place Order
                    </button>

                    <a asp-controller="Cart" asp-action="Index"
                       class="btn btn-outline-dark btn-lg w-100 mt-2">
                        <i class="bi bi-arrow-left"></i> Back to Cart
                    </a>
                </form>
            </div>
        </div>
    </div>

    <!-- Order Summary -->
    <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4">
                    <i class="bi bi-receipt"></i> Order Summary
                </h5>

                @foreach (var item in Model)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="@item.ImageUrl"
                             style="width:55px;height:50px;object-fit:cover;border-radius:8px" />
                        <div class="flex-grow-1">
                            <div class="fw-bold" style="font-size:14px">@item.ProductName</div>
                            <div class="text-muted" style="font-size:13px">
                                @item.Quantity x $@item.UnitPrice.ToString("0.00")
                            </div>
                        </div>
                        <div class="fw-bold">$@item.Total.ToString("0.00")</div>
                    </div>
                    <hr class="my-2"/>
                }

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal</span>
                    <span>$@Model.Sum(c => c.Total).ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Shipping</span>
                    <span class="text-success fw-bold">Free</span>
                </div>
                <hr/>
                <div class="d-flex justify-content-between">
                    <span class="fw-bold fs-5">Total</span>
                    <span class="fw-bold fs-5" style="color:#1a1a2e">
                        $@Model.Sum(c => c.Total).ToString("0.00")
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>