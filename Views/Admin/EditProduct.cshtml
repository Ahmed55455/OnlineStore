@model OnlineStore.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    var categories = ViewBag.Categories as List<OnlineStore.Models.Category>;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">
                <i class="bi bi-pencil"></i> Edit Product
            </h2>
            <a asp-controller="Admin" asp-action="Products"
               class="btn btn-outline-dark btn-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5">
                <form asp-controller="Admin" asp-action="EditProduct" method="post">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Product Name</label>
                            <input type="text" name="Name"
                                   value="@Model.Name"
                                   class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Category</label>
                            <select name="CategoryId" class="form-select">
                                @foreach (var cat in categories!)
                                {
                                    if (cat.Id == Model.CategoryId)
                                    {
                                        <option value="@cat.Id" selected>@cat.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Description</label>
                            <textarea name="Description"
                                      class="form-control" required rows="3">@Model.Description</textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Price ($)</label>
                            <input type="number" name="Price" 
                                   value="@Model.Price" step="0.01" min="0"
                                   class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Stock</label>
                            <input type="number" name="Stock"
                                   value="@Model.Stock" min="0"
                                   class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Image URL</label>
                            <input type="text" name="ImageUrl"
                                   value="@Model.ImageUrl"
                                   class="form-control" required />
                        </div>
                        <div class="col-12 mt-2">
                            <button type="submit"
                                    class="btn btn-lg text-white px-5"
                                    style="background:#1a1a2e">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>