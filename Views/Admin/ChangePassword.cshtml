@{
    ViewData["Title"] = "Change Admin Password";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">
                <i class="bi bi-shield-lock"></i> Change Password
            </h2>
            <a asp-controller="Admin" asp-action="Dashboard"
               class="btn btn-outline-dark btn-sm">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock" style="font-size:48px; color:#1a1a2e"></i>
                    <h3 class="fw-bold mt-2">Change Admin Password</h3>
                    <p class="text-muted">
                        Logged in as <strong>@Context.Session.GetString("AdminUsername")</strong>
                    </p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle"></i> @TempData["Success"]
                    </div>
                }

                <form asp-controller="Admin" asp-action="ChangePassword" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Current Password</label>
                        <div class="input-group">
                            <input type="password" name="currentPassword" id="currentPassword"
                                   class="form-control form-control-lg"
                                   placeholder="Current Password" required />
                            <button type="button" class="btn btn-outline-secondary"
                                    onclick="togglePassword('currentPassword', 'eyeCurrent')">
                                <i id="eyeCurrent" class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">New Password</label>
                        <div class="input-group">
                            <input type="password" name="newPassword" id="newPassword"
                                   class="form-control form-control-lg"
                                   placeholder="new password" required />
                            <button type="button" class="btn btn-outline-secondary"
                                    onclick="togglePassword('newPassword', 'eyeNew')">
                                <i id="eyeNew" class="bi bi-eye"></i>
                            </button>
                        </div>
                        <small class="text-muted">Minimum 6 characters</small>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Confirm New Password</label>
                        <div class="input-group">
                            <input type="password" name="confirmPassword" id="confirmPassword"
                                   class="form-control form-control-lg"
                                   placeholder="Current password" required />
                            <button type="button" class="btn btn-outline-secondary"
                                    onclick="togglePassword('confirmPassword', 'eyeConfirm')">
                                <i id="eyeConfirm" class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit"
                            class="btn btn-lg w-100 text-white"
                            style="background:#1a1a2e">
                        <i class="bi bi-shield-check"></i> Change Password
                    </button>
                    <a asp-controller="Admin" asp-action="Dashboard"
                       class="btn btn-outline-dark btn-lg w-100 mt-2">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon  = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}