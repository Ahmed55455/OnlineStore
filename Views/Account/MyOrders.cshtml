@model List<OnlineStore.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<h2 class="fw-bold mb-4">
    <i class="bi bi-bag-check"></i> My Orders
</h2>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-bag-x" style="font-size:80px; color:#ccc"></i>
        <h4 class="mt-3 text-muted">You have no orders yet</h4>
        <a asp-controller="Products" asp-action="Index"
           class="btn btn-primary mt-3 px-5">
            <i class="bi bi-grid"></i> Start Shopping
        </a>
    </div>
}
else
{
    @foreach (var order in Model)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white rounded-top-4 p-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-bold fs-5">#@order.Id</span>
                    <span class="text-muted ms-3" style="font-size:13px">
                        <i class="bi bi-calendar"></i>
                        @order.OrderDate.ToString("MMM dd, yyyy hh:mm tt")
                    </span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="fw-bold text-success fs-5">
                        $@order.TotalPrice.ToString("0.00")
                    </span>
                    @if (order.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark fs-6">🟡 Pending</span>
                    }
                    else if (order.Status == "Processing")
                    {
                        <span class="badge bg-primary fs-6">🔵 Processing</span>
                    }
                    else if (order.Status == "Delivered")
                    {
                        <span class="badge bg-success fs-6">🟢 Delivered</span>
                    }
                    else if (order.Status == "Cancelled")
                    {
                        <span class="badge bg-danger fs-6">🔴 Cancelled</span>
                    }
                </div>
            </div>
            <div class="card-body p-3">
                <div class="row">
                    <div class="col-md-8">
                        <h6 class="fw-bold mb-3">
                            <i class="bi bi-box-seam"></i> Items
                        </h6>
                        @foreach (var item in order.OrderItems)
                        {
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <img src="@item.Product?.ImageUrl"
                                     style="width:50px;height:45px;object-fit:cover;border-radius:8px" />
                                <div>
                                    <div class="fw-bold" style="font-size:14px">
                                        @item.Product?.Name
                                    </div>
                                    <div class="text-muted" style="font-size:13px">
                                        @item.Quantity x $@item.UnitPrice.ToString("0.00")
                                        = <strong>$@((item.Quantity * item.UnitPrice).ToString("0.00"))</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="col-md-4">
                        <h6 class="fw-bold mb-3">
                            <i class="bi bi-geo-alt"></i> Delivery Address
                        </h6>
                        <p class="text-muted" style="font-size:14px">
                            @order.Address
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
}